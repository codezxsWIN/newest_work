# Copy to .env and fill in. Never commit .env.

# Prevent the agent (or anyone) from reaching PyPI. Install from wheels/ only.
PIP_NO_INDEX=1
PIP_FIND_LINKS=./wheels

# Local model (runs on the host; the agent never pulls it)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ZAP daemon (if run as a container by a human)
ZAP_URL=http://localhost:8090
ZAP_API_KEY=

# Optional: raises the NVD rate limit for the HUMAN-run feed refresh. Leave empty otherwise.
NVD_API_KEY=
